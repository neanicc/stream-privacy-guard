{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(cmake *)",
      "Bash(ctest *)",
      "Bash(ninja *)",
      "Bash(ccache *)",
      "Bash(bash scripts/ci/run.sh *)",
      "Bash(bash scripts/link_skills.sh)",
      "Bash(python3 scripts/agent/*)",
      "Bash(python3 scripts/check_agent_files.py)",
      "Bash(python3 scripts/fetch_models.py *)",
      "Bash(python3 scripts/fetch_deps.py *)",
      "Bash(gh auth status)",
      "Bash(git remote get-url origin)",
      "Bash(scripts/ci/run.sh *)",
      "Bash(git status*)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git show *)",
      "Bash(git fetch *)",
      "Bash(git switch *)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git merge *)",
      "Bash(git pull --ff-only*)",
      "Bash(git rev-parse *)",
      "Bash(git merge-base *)",
      "Bash(git worktree list*)",
      "Bash(git worktree add *)",
      "Bash(git branch *)",
      "Bash(git push)",
      "Bash(git push -u origin agent/*)",
      "Bash(git push origin agent/*)",
      "Bash(gh pr view *)",
      "Bash(gh pr list *)",
      "Bash(gh pr diff *)",
      "Bash(gh pr checks *)",
      "Bash(gh pr checkout *)",
      "Bash(gh pr create *)",
      "Bash(gh pr edit *)",
      "Bash(gh pr ready *)",
      "Bash(gh pr comment *)",
      "Bash(gh pr merge * --squash --delete-branch --match-head-commit *)",
      "Bash(gh issue view *)",
      "Bash(gh issue list *)",
      "Bash(gh issue create *)",
      "Bash(gh issue edit *)",
      "Bash(gh issue comment *)",
      "Bash(gh run view *)",
      "Bash(gh run list *)",
      "Bash(gh run watch *)",
      "Bash(gh run download *)",
      "Bash(gh run rerun *)",
      "Bash(gh repo view *)",
      "Bash(gh secret list*)",
      "Bash(date *)",
      "Bash(sleep *)"
    ],
    "deny": [
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(git push * --force*)",
      "Bash(git push * -f*)",
      "Bash(git push * +*)",
      "Bash(git push * main*)",
      "Bash(git push * HEAD:main*)",
      "Bash(git push * *:main*)",
      "Bash(gh pr merge * --admin*)",
      "Bash(gh pr merge * --auto*)",
      "Bash(gh pr edit *human-approved*)",
      "Bash(gh pr create *human-approved*)",
      "Bash(gh issue edit *human-approved*)",
      "Bash(gh issue create *human-approved*)",
      "Bash(gh api *human-approved*)",
      "Bash(gh api *rulesets*)",
      "Bash(gh api *protection*)",
      "Bash(gh api *pulls/*/merge*)",
      "Bash(gh label *)",
      "Bash(gh repo edit*)",
      "Bash(gh repo delete*)",
      "Bash(gh secret set*)",
      "Bash(gh secret delete*)",
      "Bash(gh variable *)",
      "Bash(gh auth token*)",
      "Bash(gh auth refresh*)",
      "Bash(gh auth login*)",
      "Bash(gh auth logout*)",
      "Edit(**/eval/thresholds.toml)",
      "Edit(**/.github/**)",
      "Edit(**/.greptile/**)",
      "Edit(**/.claude/settings.json)",
      "Edit(**/.claude/hooks/**)",
      "Edit(**/.claude/agents/**)",
      "Edit(**/.agents/**)",
      "Edit(**/scripts/agent/**)",
      "Edit(**/scripts/bootstrap/**)",
      "Edit(**/AGENTS.md)",
      "Edit(**/CLAUDE.md)",
      "Edit(**/LICENSE)",
      "Bash(gh auth status *-t*)",
      "Bash(gh auth status *--show-token*)",
      "Bash(gh alias *)",
      "Bash(gh api graphql*erge*)",
      "Bash(git remote add*)",
      "Bash(git remote set-url*)",
      "Bash(git remote remove*)",
      "Bash(git remote rename*)",
      "Bash(git config *remote.*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PROJECT_DIR}/.claude/hooks/guard_merge.py\"",
            "timeout": 180,
            "onFailure": "block"
          }
        ]
      }
    ]
  },
  "env": {
    "BASH_DEFAULT_TIMEOUT_MS": "600000",
    "BASH_MAX_TIMEOUT_MS": "3600000"
  },
  "worktree": {
    "baseRef": "fresh"
  }
}
